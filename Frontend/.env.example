# Copy to `.env`.
#
# Mock mode (default) runs the whole UI from typed in-memory fixtures with no
# backend. Set VITE_USE_MOCK=false to talk to the real API.
VITE_USE_MOCK=true

# Must include the backend's API prefix. The backend mounts everything under
# /api/v1 — pointing at /api alone will 404 every request.
VITE_API_URL=http://localhost:4000/api/v1
