# Copy to `.env`.
#
# Mock mode (default) runs the whole UI from typed in-memory fixtures with no
# backend. Set VITE_USE_MOCK=false to talk to the real API.
VITE_USE_MOCK=true

# Port the backend listens on. The client combines this with the hostname the
# browser is already using, so one build works on localhost and over the LAN.
VITE_API_PORT=4300

# Override only when the API is on a different host to the web app. Must
# include the /api/v1 prefix.
# VITE_API_URL=http://192.168.1.50:4300/api/v1
