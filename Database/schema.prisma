// GlobeTrotter — relational schema
//
// Conventions applied to every model:
//   * UUID primary key (`@default(uuid())`)
//   * `created_at` / `updated_at` timestamps
//   * snake_case table + column names via @map/@@map, camelCase in TypeScript
//   * explicit foreign keys with deliberate onDelete behaviour
//
// Cascade policy:
//   deleting a user removes everything they privately own (profile, tokens,
//   sessions, trips, notifications). Reference data (cities, activity catalog)
//   is never cascaded away by user actions. Audit logs survive user deletion
//   with a nulled actor so the compliance trail is not destroyed.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  USER
  ADMIN
}

/// Role of a user *within a single trip* (distinct from the platform Role).
enum TripMemberRole {
  OWNER
  EDITOR
  VIEWER
}

enum TripStatus {
  DRAFT
  PLANNED
  ONGOING
  COMPLETED
  CANCELLED
}

/// Categories drive the budget breakdown required by the PRD.
enum ExpenseCategory {
  TRANSPORT
  STAY
  MEALS
  ACTIVITIES
  SHOPPING
  OTHER
}

enum ActivityType {
  SIGHTSEEING
  FOOD
  ADVENTURE
  CULTURE
  NATURE
  NIGHTLIFE
  SHOPPING
  RELAXATION
  TRANSPORT
  OTHER
}

enum NotificationType {
  TRIP_CREATED
  TRIP_UPDATED
  TRIP_SHARED
  TRIP_COPIED
  BUDGET_ALERT
  MEMBER_ADDED
  SYSTEM
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(uuid()) @db.Uuid
  /// Always stored normalized (trimmed + lowercased) so uniqueness is real.
  email         String    @unique @db.VarChar(255)
  passwordHash  String    @map("password_hash") @db.Text
  name          String    @db.VarChar(120)
  role          Role      @default(USER)
  isActive      Boolean   @default(true) @map("is_active")
  emailVerified Boolean   @default(false) @map("email_verified")
  lastLoginAt   DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  profile       Profile?
  trips         Trip[]              @relation("TripOwner")
  memberships   TripMember[]
  refreshTokens RefreshToken[]
  sessions      Session[]
  notifications Notification[]
  auditLogs     AuditLog[]
  sharedLinks   SharedItinerary[]
  expenses      Expense[]           @relation("ExpenseCreator")
  resetTokens   PasswordResetToken[]

  @@index([role])
  @@index([createdAt])
  @@map("users")
}

model Profile {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @unique @map("user_id") @db.Uuid
  avatarUrl         String?  @map("avatar_url") @db.Text
  bio               String?  @db.VarChar(500)
  language          String   @default("en") @db.VarChar(10)
  currency          String   @default("USD") @db.VarChar(3)
  country           String?  @db.VarChar(80)
  phone             String?  @db.VarChar(30)
  /// City ids the user bookmarked ("saved destinations list" in the PRD).
  savedDestinations String[] @default([]) @map("saved_destinations")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  sessionId String?   @map("session_id") @db.Uuid
  /// SHA-256 of the raw token — the raw value never touches the database.
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  /// Set when rotation issues a successor — enables reuse detection.
  replacedBy String?  @map("replaced_by") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  session Session? @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Session {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  userAgent   String?   @map("user_agent") @db.VarChar(512)
  ipAddress   String?   @map("ip_address") @db.VarChar(64)
  deviceLabel String?   @map("device_label") @db.VarChar(120)
  lastUsedAt  DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(6)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(6)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// ---------------------------------------------------------------------------
// Reference data (seeded, not user-owned)
// ---------------------------------------------------------------------------

model City {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(120)
  country     String   @db.VarChar(80)
  countryCode String   @map("country_code") @db.VarChar(2)
  region      String   @db.VarChar(60)
  timezone    String   @db.VarChar(60)
  latitude    Decimal  @db.Decimal(9, 6)
  longitude   Decimal  @db.Decimal(9, 6)
  /// 0-100 relative daily-spend index; drives budget estimates and sorting.
  costIndex   Int      @default(50) @map("cost_index")
  /// 0-100 popularity score used by "recommended destinations".
  popularity  Int      @default(50)
  currency    String   @db.VarChar(3)
  description String?  @db.Text
  imageUrl    String?  @map("image_url") @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  activities Activity[]
  stops      Stop[]

  @@unique([name, country])
  @@index([country])
  @@index([region])
  @@index([popularity])
  @@map("cities")
}

/// Catalog of things to do. Rows are reference data shared by every trip;
/// scheduling a catalog activity into a stop creates a StopActivity.
model Activity {
  id             String       @id @default(uuid()) @db.Uuid
  cityId         String       @map("city_id") @db.Uuid
  name           String       @db.VarChar(160)
  type           ActivityType @default(OTHER)
  description    String?      @db.Text
  imageUrl       String?      @map("image_url") @db.Text
  /// Estimated cost per person in `currency`.
  estimatedCost  Decimal      @default(0) @map("estimated_cost") @db.Decimal(12, 2)
  currency       String       @default("USD") @db.VarChar(3)
  durationMinutes Int         @default(60) @map("duration_minutes")
  popularity     Int          @default(50)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  city           City           @relation(fields: [cityId], references: [id], onDelete: Cascade)
  stopActivities StopActivity[]

  @@unique([cityId, name])
  @@index([type])
  @@index([popularity])
  @@map("activities")
}

// ---------------------------------------------------------------------------
// Trips
// ---------------------------------------------------------------------------

model Trip {
  id            String     @id @default(uuid()) @db.Uuid
  ownerId       String     @map("owner_id") @db.Uuid
  name          String     @db.VarChar(160)
  description   String?    @db.Text
  coverImageUrl String?    @map("cover_image_url") @db.Text
  startDate     DateTime   @map("start_date") @db.Date
  endDate       DateTime   @map("end_date") @db.Date
  travelers     Int        @default(1)
  currency      String     @default("USD") @db.VarChar(3)
  status        TripStatus @default(PLANNED)
  isPublic      Boolean    @default(false) @map("is_public")
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  owner    User              @relation("TripOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members  TripMember[]
  stops    Stop[]
  budget   Budget?
  expenses Expense[]
  shares   SharedItinerary[]

  @@index([ownerId])
  @@index([startDate])
  @@index([status])
  @@map("trips")
}

model TripMember {
  id       String         @id @default(uuid()) @db.Uuid
  tripId   String         @map("trip_id") @db.Uuid
  userId   String         @map("user_id") @db.Uuid
  role     TripMemberRole @default(VIEWER)
  joinedAt DateTime       @default(now()) @map("joined_at") @db.Timestamptz(6)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tripId, userId])
  @@index([userId])
  @@map("trip_members")
}

/// One city visit inside a trip. `sequence` is the drag-and-drop order and is
/// kept dense (0..n-1) by StopService.
model Stop {
  id           String   @id @default(uuid()) @db.Uuid
  tripId       String   @map("trip_id") @db.Uuid
  cityId       String   @map("city_id") @db.Uuid
  sequence     Int
  arrivalDate  DateTime @map("arrival_date") @db.Date
  departureDate DateTime @map("departure_date") @db.Date
  notes        String?  @db.Text
  /// Lodging cost for the whole stop, in the trip currency.
  accommodationCost Decimal @default(0) @map("accommodation_cost") @db.Decimal(12, 2)
  /// Cost of travelling *to* this stop (flight/train/bus leg).
  transportCost     Decimal @default(0) @map("transport_cost") @db.Decimal(12, 2)
  /// Per-person per-day food estimate.
  mealsPerDayCost   Decimal @default(0) @map("meals_per_day_cost") @db.Decimal(12, 2)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  trip       Trip           @relation(fields: [tripId], references: [id], onDelete: Cascade)
  city       City           @relation(fields: [cityId], references: [id], onDelete: Restrict)
  activities StopActivity[]
  expenses   Expense[]

  @@unique([tripId, sequence])
  @@index([tripId])
  @@index([cityId])
  @@map("stops")
}

/// Join table: a catalog Activity scheduled into a Stop, with trip-specific
/// overrides (time, actual cost, notes) that must not mutate the catalog row.
model StopActivity {
  id              String    @id @default(uuid()) @db.Uuid
  stopId          String    @map("stop_id") @db.Uuid
  activityId      String    @map("activity_id") @db.Uuid
  /// Which day of the stop this lands on, and ordering within that day.
  scheduledDate   DateTime? @map("scheduled_date") @db.Date
  startTime       String?   @map("start_time") @db.VarChar(5)
  endTime         String?   @map("end_time") @db.VarChar(5)
  sequence        Int       @default(0)
  /// Overrides Activity.estimatedCost when the traveler knows the real price.
  costOverride    Decimal?  @map("cost_override") @db.Decimal(12, 2)
  durationOverride Int?     @map("duration_override")
  notes           String?   @db.Text
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  stop     Stop     @relation(fields: [stopId], references: [id], onDelete: Cascade)
  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@unique([stopId, activityId])
  @@index([stopId])
  @@index([scheduledDate])
  @@map("stop_activities")
}

// ---------------------------------------------------------------------------
// Money
// ---------------------------------------------------------------------------

/// Denormalized-on-purpose rollup: one row per trip holding the latest
/// computed totals so the dashboard can read budgets without recomputing
/// every trip. BudgetService.recalculate() is the single writer.
model Budget {
  id              String   @id @default(uuid()) @db.Uuid
  tripId          String   @unique @map("trip_id") @db.Uuid
  currency        String   @default("USD") @db.VarChar(3)
  /// Optional ceiling set by the user; powers overbudget alerts.
  plannedTotal    Decimal? @map("planned_total") @db.Decimal(12, 2)
  transportTotal  Decimal  @default(0) @map("transport_total") @db.Decimal(12, 2)
  stayTotal       Decimal  @default(0) @map("stay_total") @db.Decimal(12, 2)
  mealsTotal      Decimal  @default(0) @map("meals_total") @db.Decimal(12, 2)
  activitiesTotal Decimal  @default(0) @map("activities_total") @db.Decimal(12, 2)
  otherTotal      Decimal  @default(0) @map("other_total") @db.Decimal(12, 2)
  grandTotal      Decimal  @default(0) @map("grand_total") @db.Decimal(12, 2)
  perDayAverage   Decimal  @default(0) @map("per_day_average") @db.Decimal(12, 2)
  /// Daily ceiling; days above it are reported as overbudget.
  dailyLimit      Decimal? @map("daily_limit") @db.Decimal(12, 2)
  lastCalculatedAt DateTime @default(now()) @map("last_calculated_at") @db.Timestamptz(6)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@map("budgets")
}

/// Ad-hoc money the traveler logs on top of the itinerary-derived estimates.
model Expense {
  id          String          @id @default(uuid()) @db.Uuid
  tripId      String          @map("trip_id") @db.Uuid
  stopId      String?         @map("stop_id") @db.Uuid
  createdById String?         @map("created_by_id") @db.Uuid
  category    ExpenseCategory @default(OTHER)
  title       String          @db.VarChar(160)
  amount      Decimal         @db.Decimal(12, 2)
  currency    String          @default("USD") @db.VarChar(3)
  incurredOn  DateTime        @map("incurred_on") @db.Date
  notes       String?         @db.Text
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  trip      Trip  @relation(fields: [tripId], references: [id], onDelete: Cascade)
  stop      Stop? @relation(fields: [stopId], references: [id], onDelete: SetNull)
  createdBy User? @relation("ExpenseCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([tripId])
  @@index([category])
  @@index([incurredOn])
  @@map("expenses")
}

// ---------------------------------------------------------------------------
// Sharing
// ---------------------------------------------------------------------------

model SharedItinerary {
  id          String    @id @default(uuid()) @db.Uuid
  tripId      String    @map("trip_id") @db.Uuid
  createdById String    @map("created_by_id") @db.Uuid
  slug        String    @unique @db.VarChar(80)
  isActive    Boolean   @default(true) @map("is_active")
  /// Whether anonymous visitors may clone this itinerary into their account.
  allowCopy   Boolean   @default(true) @map("allow_copy")
  viewCount   Int       @default(0) @map("view_count")
  copyCount   Int       @default(0) @map("copy_count")
  expiresAt   DateTime? @map("expires_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  trip      Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  createdBy User @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@map("shared_itineraries")
}

// ---------------------------------------------------------------------------
// Ops
// ---------------------------------------------------------------------------

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  type      NotificationType @default(SYSTEM)
  title     String           @db.VarChar(160)
  body      String?          @db.Text
  /// Free-form payload (tripId, slug, …) for the client to deep-link with.
  data      Json?
  readAt    DateTime?        @map("read_at") @db.Timestamptz(6)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notifications")
}

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  /// Nulled rather than deleted when the actor's account goes away.
  actorId      String?  @map("actor_id") @db.Uuid
  action       String   @db.VarChar(80)
  resourceType String   @map("resource_type") @db.VarChar(60)
  resourceId   String?  @map("resource_id") @db.VarChar(64)
  ipAddress    String?  @map("ip_address") @db.VarChar(64)
  userAgent    String?  @map("user_agent") @db.VarChar(512)
  metadata     Json?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}
