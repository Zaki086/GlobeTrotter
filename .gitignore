# ---------------------------------------------------------------------------
# Repo-wide ignores. Each sub-project also has its own .gitignore; this is the
# safety net that keeps dependencies, build output and secrets out of every
# branch regardless of which directory someone is working in.
# ---------------------------------------------------------------------------

# Dependencies
node_modules/
**/node_modules/
.pnp
.pnp.js

# Build output
dist/
build/
.next/
out/
*.tsbuildinfo

# Environment / secrets — never commit these
.env
.env.local
.env.*.local
*.pem
*.key

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test / coverage
coverage/
.nyc_output/

# Editor & OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# Local tooling caches
.cache/
.turbo/
.eslintcache
