        {
          "name": "Add stop",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cityId\": \"{{cityId}}\",\n  \"arrivalDate\": \"2026-09-01\",\n  \"departureDate\": \"2026-09-05\",\n  \"notes\": \"Booked a hotel near the station\",\n  \"accommodationCost\": 600,\n  \"transportCost\": 250,\n  \"mealsPerDayCost\": 50\n}"
            },
            "url": { "raw": "{{baseUrl}}/trips/{{tripId}}/stops", "host": ["{{baseUrl}}"], "path": ["trips", "{{tripId}}", "stops"] },
            "description": "Dates must fall inside the trip range. Omit `sequence` to append. Recalculates the budget."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    pm.collectionVariables.set('stopId', pm.response.json().data.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Update stop",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"accommodationCost\": 750,\n  \"notes\": \"Upgraded the room\"\n}" },
            "url": { "raw": "{{baseUrl}}/stops/{{stopId}}", "host": ["{{baseUrl}}"], "path": ["stops", "{{stopId}}"] }
          }
        },
        {
          "name": "Reorder stops (drag & drop)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tripId\": \"{{tripId}}\",\n  \"stopIds\": [\"replace-with\", \"the-complete\", \"ordered-list\"],\n  \"shiftDates\": false\n}"
            },
            "url": { "raw": "{{baseUrl}}/stops/reorder", "host": ["{{baseUrl}}"], "path": ["stops", "reorder"] },
            "description": "Send the COMPLETE ordered list of stop ids for the trip. Partial lists are rejected with 400, which makes the call idempotent and safe against a stale drag. Set `shiftDates` to re-flow the arrival/departure dates into the new order."
          }
        },
        {
          "name": "Delete stop",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": { "raw": "{{baseUrl}}/stops/{{stopId}}", "host": ["{{baseUrl}}"], "path": ["stops", "{{stopId}}"] },
            "description": "Remaining stops are resequenced so the order stays dense."
          }
        },
        {
          "name": "List stop activities",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/stops/{{stopId}}/activities", "host": ["{{baseUrl}}"], "path": ["stops", "{{stopId}}", "activities"] }
          }
