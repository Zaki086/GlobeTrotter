{
  "info": {
    "_postman_id": "9d3f4c21-5a7e-4b8c-9f10-globetrotter001",
    "name": "GlobeTrotter API",
    "description": "Complete collection for the GlobeTrotter travel planning API.\n\n## Setup\n\n1. Start the stack: `docker compose up --build`\n2. Select the **GlobeTrotter Local** environment (or edit the `baseUrl` variable).\n3. Run **Auth → Login (demo)** once — it captures the access and refresh tokens into collection variables automatically, and every other request inherits them.\n\nRequests that create something (trip, stop, share link) also capture the new id, so the folders can be run top-to-bottom as a working end-to-end flow.\n\n## Seeded accounts\n\n| Role | Email | Password |\n| --- | --- | --- |\n| Admin | admin@globetrotter.app | AdminPass123! |\n| Traveler | demo@globetrotter.app | DemoPass123! |\n| Second traveler | sam@globetrotter.app | TravelBuddy123! |",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Applies to every request in the collection.",
          "pm.test('responds with the standard envelope', function () {",
          "    const body = pm.response.json();",
          "    pm.expect(body).to.have.property('success');",
          "    pm.expect(body).to.have.property('message');",
          "});",
          "",
          "pm.test('status is not 5xx', function () {",
          "    pm.expect(pm.response.code).to.be.below(500);",
          "});"
        ]
      }
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000/api/v1", "type": "string" },
    { "key": "accessToken", "value": "", "type": "string" },
    { "key": "refreshToken", "value": "", "type": "string" },
    { "key": "tripId", "value": "", "type": "string" },
    { "key": "stopId", "value": "", "type": "string" },
    { "key": "cityId", "value": "", "type": "string" },
    { "key": "activityId", "value": "", "type": "string" },
    { "key": "shareSlug", "value": "", "type": "string" },
    { "key": "shareId", "value": "", "type": "string" },
    { "key": "expenseId", "value": "", "type": "string" },
    { "key": "demoEmail", "value": "demo@globetrotter.app", "type": "string" },
    { "key": "demoPassword", "value": "DemoPass123!", "type": "string" },
    { "key": "adminEmail", "value": "admin@globetrotter.app", "type": "string" },
    { "key": "adminPassword", "value": "AdminPass123!", "type": "string" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] },
            "description": "Reports liveness plus PostgreSQL and Redis status. Returns 503 when degraded."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('service is healthy', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const d = pm.response.json().data;",
                  "    pm.expect(d.dependencies.database).to.eql('up');",
                  "    pm.expect(d.dependencies.redis).to.eql('up');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Signup",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ada Lovelace\",\n  \"email\": \"ada+{{$timestamp}}@example.com\",\n  \"password\": \"Str0ng!Passw0rd\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/signup", "host": ["{{baseUrl}}"], "path": ["auth", "signup"] },
            "description": "Rate limited to 3 per hour per IP. Password must contain lowercase, uppercase, a number and a special character."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const t = pm.response.json().data.tokens;",
                  "    pm.collectionVariables.set('accessToken', t.accessToken);",
                  "    pm.collectionVariables.set('refreshToken', t.refreshToken);",
                  "    pm.test('returns a token pair', function () {",
                  "        pm.expect(t.accessToken).to.be.a('string');",
                  "        pm.expect(t.tokenType).to.eql('Bearer');",
                  "    });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login (demo)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{demoEmail}}\",\n  \"password\": \"{{demoPassword}}\",\n  \"deviceLabel\": \"Postman\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
            "description": "Run this first. Captures accessToken and refreshToken into collection variables. Rate limited to 5 per minute per IP + email."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('login succeeds', function () { pm.response.to.have.status(200); });",
                  "const t = pm.response.json().data.tokens;",
                  "pm.collectionVariables.set('accessToken', t.accessToken);",
                  "pm.collectionVariables.set('refreshToken', t.refreshToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login (admin)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
            "description": "Use before running the Admin folder."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const t = pm.response.json().data.tokens;",
                  "    pm.collectionVariables.set('accessToken', t.accessToken);",
                  "    pm.collectionVariables.set('refreshToken', t.refreshToken);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login (wrong password)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{demoEmail}}\",\n  \"password\": \"WrongPassword123!\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
            "description": "Returns the same message as an unknown email, so accounts cannot be enumerated."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('rejected with 401', function () { pm.response.to.have.status(401); });",
                  "pm.test('message does not reveal which field was wrong', function () {",
                  "    pm.expect(pm.response.json().message).to.eql('Invalid email or password');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh token",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/auth/refresh", "host": ["{{baseUrl}}"], "path": ["auth", "refresh"] },
            "description": "Rotates the refresh token. Replaying a consumed token revokes the entire session."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const t = pm.response.json().data.tokens;",
                  "    pm.test('token was rotated', function () {",
                  "        pm.expect(t.refreshToken).to.not.eql(pm.collectionVariables.get('refreshToken'));",
                  "    });",
                  "    pm.collectionVariables.set('accessToken', t.accessToken);",
                  "    pm.collectionVariables.set('refreshToken', t.refreshToken);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Current user",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/auth/me", "host": ["{{baseUrl}}"], "path": ["auth", "me"] }
          }
        },
        {
          "name": "Active sessions",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/auth/sessions", "host": ["{{baseUrl}}"], "path": ["auth", "sessions"] },
            "description": "Every live session, so a user can spot unfamiliar devices."
          }
        },
        {
          "name": "Forgot password",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{demoEmail}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/auth/forgot-password", "host": ["{{baseUrl}}"], "path": ["auth", "forgot-password"] },
            "description": "Always 200, whether or not the email exists. Outside production the reset token is returned in the response so the flow is testable without email."
          }
        },
        {
          "name": "Change password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"{{demoPassword}}\",\n  \"newPassword\": \"NewStr0ng!Pass\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/change-password", "host": ["{{baseUrl}}"], "path": ["auth", "change-password"] },
            "description": "Revokes every other session, keeping only the one making the change."
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"allDevices\": false\n}" },
            "url": { "raw": "{{baseUrl}}/auth/logout", "host": ["{{baseUrl}}"], "path": ["auth", "logout"] }
          }
        },
        {
          "name": "Logout all devices",
          "request": {
            "method": "POST",
            "header": [],
            "url": { "raw": "{{baseUrl}}/auth/logout-all", "host": ["{{baseUrl}}"], "path": ["auth", "logout-all"] }
          }
        }
      ]
    },
