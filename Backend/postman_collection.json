    {
      "name": "Trips",
      "item": [
        {
          "name": "Create trip",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Test Trip\",\n  \"description\": \"Created from the Postman collection\",\n  \"startDate\": \"2026-09-01\",\n  \"endDate\": \"2026-09-14\",\n  \"travelers\": 2,\n  \"currency\": \"USD\",\n  \"plannedTotal\": 5000\n}"
            },
            "url": { "raw": "{{baseUrl}}/trips", "host": ["{{baseUrl}}"], "path": ["trips"] },
            "description": "Rate limited to 20 per hour."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    pm.collectionVariables.set('tripId', pm.response.json().data.id);",
                  "    pm.test('trip created', function () { pm.response.to.have.status(201); });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "List trips",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/trips?filter=all&page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["trips"],
              "query": [
                { "key": "filter", "value": "all", "description": "all | upcoming | ongoing | past" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" },
                { "key": "search", "value": "", "disabled": true },
                { "key": "status", "value": "PLANNED", "disabled": true },
                { "key": "sortBy", "value": "startDate", "disabled": true }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json().data;",
                  "if (d && d.length && !pm.collectionVariables.get('tripId')) {",
                  "    pm.collectionVariables.set('tripId', d[0].id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get trip",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/trips/{{tripId}}", "host": ["{{baseUrl}}"], "path": ["trips", "{{tripId}}"] },
            "description": "Full detail: stops, scheduled activities, members, budget totals and share links."
          }
        },
        {
          "name": "Update trip",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Postman Test Trip (updated)\",\n  \"travelers\": 3\n}" },
            "url": { "raw": "{{baseUrl}}/trips/{{tripId}}", "host": ["{{baseUrl}}"], "path": ["trips", "{{tripId}}"] },
            "description": "Narrowing the date range returns 409 if stops would fall outside it."
          }
        },
        {
          "name": "Add collaborator",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
