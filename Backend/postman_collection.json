            "url": { "raw": "{{baseUrl}}/trips/{{tripId}}/members", "host": ["{{baseUrl}}"], "path": ["trips", "{{tripId}}", "members"] },
            "description": "Owner only. EDITOR can modify the itinerary, VIEWER is read-only."
          }
        },
        {
          "name": "Delete trip",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": { "raw": "{{baseUrl}}/trips/{{tripId}}", "host": ["{{baseUrl}}"], "path": ["trips", "{{tripId}}"] },
