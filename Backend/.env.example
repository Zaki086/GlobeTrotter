# ---------------------------------------------------------------------------
# GlobeTrotter Backend — environment configuration
# Copy to `.env` and adjust. Every value below has a safe local default in
# docker-compose.yml; the JWT secrets MUST be replaced for any real deployment.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# --- Database -------------------------------------------------------------
# Inside docker-compose the host is `postgres`; running bare metal use localhost.
DATABASE_URL=postgresql://globetrotter:globetrotter@localhost:5432/globetrotter?schema=public

# --- Redis ----------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# --- JWT ------------------------------------------------------------------
# Generate with: openssl rand -hex 64
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters-long
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
JWT_ISSUER=globetrotter.api
JWT_AUDIENCE=globetrotter.client

# --- CORS -----------------------------------------------------------------
# Comma separated whitelist. "*" is only honoured when NODE_ENV=development.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8081

# --- Limits ---------------------------------------------------------------
JSON_BODY_LIMIT=1mb
RATE_LIMIT_ENABLED=true

# --- Logging --------------------------------------------------------------
LOG_LEVEL=info
LOG_DIR=logs

# --- Public sharing -------------------------------------------------------
PUBLIC_APP_URL=http://localhost:3000

# --- Seeded accounts (used by prisma/seed.ts) -----------------------------
SEED_ADMIN_EMAIL=admin@globetrotter.app
SEED_ADMIN_PASSWORD=AdminPass123!
SEED_DEMO_EMAIL=demo@globetrotter.app
SEED_DEMO_PASSWORD=DemoPass123!
